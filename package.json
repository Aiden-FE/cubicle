{
  "name": "cubicle",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "一间看得见的办公室：AI 数字员工在工位上干活，你招聘、派活、验收。",
  "engines": {
    "node": ">=22.19.0"
  },
  "main": "src/main/index.mjs",
  "scripts": {
    "spike": "node spike/run.mjs",
    "test": "node --test --experimental-test-isolation=none test/*.test.mjs",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.renderer.json",
    "check": "npm run typecheck && npm test",
    "build:renderer": "vite build",
    "start": "node scripts/start.mjs",
    "package": "electron-builder --win --dir",
    "e2e:02": "node scripts/e2e-02.mjs",
    "e2e:03": "node scripts/e2e-03.mjs",
    "e2e:04": "node scripts/e2e-04.mjs",
    "e2e:05": "node scripts/e2e-05.mjs",
    "e2e:06": "node scripts/e2e-06.mjs",
    "e2e:07": "node scripts/e2e-07.mjs",
    "e2e:08": "node scripts/e2e-08.mjs",
    "e2e:09": "node scripts/e2e-09.mjs",
    "e2e:10": "node scripts/e2e-10.mjs",
    "e2e:11": "node scripts/e2e-11.mjs",
    "e2e:12": "node scripts/e2e-12.mjs",
    "e2e:13": "node scripts/e2e-13.mjs",
    "e2e:14": "node scripts/e2e-14.mjs"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "1.5.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "22.19.1",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "electron": "45.2.1",
    "electron-builder": "^26.18.0",
    "typescript": "5.9.3",
    "vite": "^6.4.5",
    "yaml": "2.9.0"
  }
}
