{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "types": ["node"],
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": [
    "spike/**/*.mjs",
    "spike/**/*.cjs",
    "test/**/*.mjs",
    "src/**/*.mjs",
    "src/**/*.cjs",
    "scripts/**/*.mjs"
  ],
  "exclude": ["node_modules", "tmp"]
}
