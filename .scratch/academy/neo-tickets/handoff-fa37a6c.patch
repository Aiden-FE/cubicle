+/**
+ * `neo materialize --role <name> --agent <id> --out <dir> [--json]`(academy 票 01):
+ * 把 `role × agent` 启动根的「资源部分」导出到外部目录;只落盘、绝不启动进程。
+ * 产物与 `roots/<role>/<agent>/` 同形(同一 `convergeRoot` 渲染路径),落盘恒「暂存 + 换出」,
+ * NEO_HOME 只读(不写 state/,不建 roots/)。退出码:usage=2 / state·failure=1(reportError 映射)。
+ */
+async function cmdMaterialize(args: readonly string[], io: CliIo, deps: CliDeps): Promise<number> {
+  const parsed = parseArgs(args, {
+    valued: new Set(['role', 'agent', 'out']),
+    boolean: boolFlags('json'),
+  });
+  if (parsed.positionals.length > 0) {
+    throw new NeoError('usage', 'materialize: takes no positional arguments');
+  }
+  const role = lastFlag(parsed, 'role');
+  const agent = lastFlag(parsed, 'agent');
+  const out = lastFlag(parsed, 'out');
+  if (role === undefined) throw new NeoError('usage', 'materialize: --role <name> is required');
+  if (agent === undefined) {
+    throw new NeoError(
+      'usage',
+      `materialize: --agent <agent-id> is required (neo materialize launches: ${(await launchableIds(deps)).join(', ')})`,
+    );
+  }
+  if (out === undefined || out.trim().length === 0) {
+    throw new NeoError('usage', 'materialize: --out <dir> is required');
+  }
+  const cwd = deps.cwd ?? process.cwd();
+  const { manifest } = await materializeRoot(
+    { link: nodeLinkPort(), now: deps.now },
+    resolveHome(deps),
+    deps.homedir,
+    { role, agent, out: path.resolve(cwd, out), env: deps.env },
+  );
+  if (parsed.bools.has('json')) {
+    io.stdout(`${JSON.stringify(manifest, null, 2)}\n`);
+    return 0;
+  }
+  io.stdout(`materialized role=${role} agent=${agent}: ${manifest.outDir}\n`);
+  io.stdout(`  skills: ${manifest.skills.map((s) => `${s.name} (${s.source})`).join(', ') || 'none'}\n`);
+  io.stdout(
+    `  mcp: ${manifest.mcp.servers} server(s)${manifest.mcp.file === null ? '' : ` -> ${manifest.mcp.file}`}\n`,
+  );
+  io.stdout(
+    `  model: ${manifest.model.default ?? 'none'}${manifest.model.file === null ? '' : ` -> ${manifest.model.file}`}\n`,
+  );
+  io.stdout('  (resources only: neo materialize never launches a process)\n');
+  return 0;
+}
