diff --git a/packages/core/src/materialize.ts b/packages/core/src/materialize.ts
new file mode 100644
index 0000000..459813a
--- /dev/null
+++ b/packages/core/src/materialize.ts
@@ -0,0 +1,252 @@
+import { createHash, randomUUID } from 'node:crypto';
+import fs from 'node:fs/promises';
+import path from 'node:path';
+import { NeoError } from './error.js';
+import type { LinkPort } from './link-port.js';
+import { computeSkillFolderHash } from './migrate.js';
+import { validateRoleName } from './names.js';
+import { convergeRoot, type RootPorts, type RootReport } from './roots.js';
+
+/**
+ * academy 票 01:`neo materialize` 的 core 接缝 —— 把 `role × agent` 启动根的
+ * 「资源部分」(技能链接、渲染后的指令文件、MCP 配置、模型文件、root.json)
+ * 物化到外部目录,**不启动任何进程**。
+ * 产物由 `convergeRoot`(与 `roots/<role>/<agent>/` 同一条渲染路径)产出,
+ * 同形、不允许第二份实现;落盘走「暂存 + rename」,禁止半写。
+ * 只读保证:除 root 目标外,不写 NEO_HOME 的任何路径(含 state/locks 与 roles)。
+ */
+
+export interface MaterializeOptions {
+  role: string;
+  agent: string;
+  /** 外部目标目录(调用方保证绝对路径;`~` 展开在 CLI 层)。 */
+  out: string;
+  env?: Readonly<Record<string, string | undefined>>;
+}
+
+/** 与 `convergeRoot` 同款端口;`now` 只影响 root.json 的 createdAt(清单不含)。 */
+export type MaterializePorts = RootPorts;
+
+export interface MaterializeSkillEntry {
+  name: string;
+  /** 内容哈希(与 update/migrate 同一 `computeSkillFolderHash` 约定)。 */
+  hash: string;
+  /** 胜出的装配层:角色名或 default(同名胜者可读)。 */
+  source: string;
+}
+
+export interface MaterializeManifest {
+  ok: true;
+  role: string;
+  agent: string;
+  outDir: string;
+  skills: MaterializeSkillEntry[];
+  /** out 内相对文件名(未渲染 → null);servers = default ∪ role 合并后的 server 数。 */
+  mcp: { file: string | null; servers: number };
+  /** out 内相对文件名(未渲染 → null);不含 env 引用值(密钥不落清单)。 */
+  model: { file: string | null; providers: number; default: string | null };
+  /** 资源集合指纹:sha256(role/agent/skills/mcp/model 的规范化 JSON;与时间戳、outDir 无关)。 */
+  hash: string;
+}
+
+export interface MaterializeResult {
+  outDir: string;
+  manifest: MaterializeManifest;
+}
+
+/** root.json 标记(与 convergeRoot 写出的形状一致)。 */
+interface RootMarker {
+  version: number;
+  role: string;
+  agent: string;
+}
+
+async function readMarker(dir: string): Promise<RootMarker | null> {
+  try {
+    const raw: unknown = JSON.parse(await fs.readFile(path.join(dir, 'root.json'), 'utf8'));
+    if (
+      typeof raw === 'object' &&
+      raw !== null &&
+      (raw as { version?: unknown }).version === 1 &&
+      typeof (raw as { role?: unknown }).role === 'string' &&
+      typeof (raw as { agent?: unknown }).agent === 'string'
+    ) {
+      return raw as unknown as RootMarker;
+    }
+    return null;
+  } catch {
+    return null;
+  }
+}
+
+/** 与目标同目录的暂存名:同文件系统,rename 才可靠;`.` 前缀避免被当成正式产物。 */
+function stagingFor(out: string): string {
+  return path.join(
+    path.dirname(out),
+    `.${path.basename(out)}.materialize-${randomUUID()}.tmp`,
+  );
+}
+
+/**
+ * 链接安全删除:目录链接(win junction / POSIX symlink)先经 link 端口解链,
+ * 绝不把删除操作穿透到角色技能或用户全局目录的真实内容。
+ */
+async function removeMaterializedTree(link: LinkPort, dir: string): Promise<void> {
+  for (const entry of await fs.readdir(dir, { withFileTypes: true })) {
+    const abs = path.join(dir, entry.name);
+    const info = await fs.lstat(abs);
+    if (info.isSymbolicLink()) {
+      await link.unlink(abs);
+    } else if (info.isDirectory()) {
+      await removeMaterializedTree(link, abs);
+      await fs.rmdir(abs);
+    } else {
+      await fs.unlink(abs);
+    }
+  }
+}
+
+type OutState = { kind: 'new' } | { kind: 'empty' } | { kind: 'owned' };
+
+/** 拒绝条件先于任何写入:`--out` 是文件/链接,或目录里有非本命令产物 → state 错。 */
+async function assertOutUsable(out: string, role: string, agent: string): Promise<OutState> {
+  let info: Awaited<ReturnType<typeof fs.lstat>>;
+  try {
+    info = await fs.lstat(out);
+  } catch (error) {
+    if ((error as NodeJS.ErrnoException).code === 'ENOENT') return { kind: 'new' };
+    throw error;
+  }
+  if (!info.isDirectory()) {
+    throw new NeoError('state', `--out is not a directory: ${out}`);
+  }
+  const contents = await fs.readdir(out);
+  if (contents.length === 0) return { kind: 'empty' };
+  const marker = await readMarker(out);
+  if (marker === null) {
+    throw new NeoError(
+      'state',
+      `--out already exists and is not a neo materialize product (missing root.json marker): ${out}`,
+    );
+  }
+  if (marker.role !== role || marker.agent !== agent) {
+    throw new NeoError(
+      'state',
+      `--out is a neo materialize product for a different target ` +
+        `(has role="${marker.role}" agent="${marker.agent}", requested role="${role}" agent="${agent}"); ` +
+        `choose another --out or remove the directory`,
+    );
+  }
+  return { kind: 'owned' };
+}
+
+function manifestHash(manifest: Omit<MaterializeManifest, 'hash' | 'outDir' | 'ok'>): string {
+  const canonical = JSON.stringify({
+    role: manifest.role,
+    agent: manifest.agent,
+    skills: manifest.skills,
+    mcp: manifest.mcp,
+    model: manifest.model,
+  });
+  return createHash('sha256').update(canonical, 'utf8').digest('hex');
+}
+
+/**
+ * 替换既有产物的「换出再换入」:旧根先原子改名成暂存兄弟(`.out.old-<uuid>.tmp`),
+ * 再把新根 rename 进来,最后才删旧根。任一 rename 失败都把旧根改回 —— out 要么旧要么新,绝不半写。
+ */
+async function swapOutOwned(link: LinkPort, out: string, staging: string): Promise<void> {
+  const backup = path.join(
+    path.dirname(out),
+    `.${path.basename(out)}.old-${randomUUID()}.tmp`,
+  );
+  await fs.rename(out, backup);
+  try {
+    await fs.rename(staging, out);
+  } catch (error) {
+    // 换入失败:旧根原地改回,out 保持旧态;暂存由调用方清理,绝不留两个真相。
+    await fs.rename(backup, out).catch(() => undefined);
+    throw new NeoError(
+      'failure',
+      `materialize: swap into ${out} failed (${(error as Error).message}); ` +
+        `old root restored (or preserved at ${backup}), nothing half-written`,
+    );
+  }
+  await removeMaterializedTree(link, backup).catch(() => undefined);
+  await fs.rm(backup, { recursive: true, force: true }).catch(() => undefined);
+}
+
+export async function materializeRoot(
+  ports: MaterializePorts,
+  home: string,
+  homedir: string,
+  opts: MaterializeOptions,
+): Promise<MaterializeResult> {
+  validateRoleName(opts.role);
+  const outState = await assertOutUsable(opts.out, opts.role, opts.agent);
+
+  const staging = stagingFor(opts.out);
+  let report: RootReport;
+  try {
+    report = await convergeRoot(ports, home, homedir, {
+      role: opts.role,
+      agent: opts.agent,
+      root: staging,
+      ...(opts.env !== undefined ? { env: opts.env } : {}),
+    });
+  } catch (error) {
+    // 中途失败:清掉半套暂存(链接只解链不穿透),绝不 rename 到 out。
+    await removeMaterializedTree(ports.link, staging).catch(() => undefined);
+    await fs.rm(staging, { recursive: true, force: true }).catch(() => undefined);
+    throw error;
+  }
+
+  try {
+    if (outState.kind === 'owned') {
+      // 只替换「本命令产物」(marker 已核验):换出旧根 → 换入新根 → 删旧根。
+      await swapOutOwned(ports.link, opts.out, staging);
+    } else {
+      // Windows 的 rename 不允许落到已存在目录(哪怕是空壳);先摘掉。
+      if (outState.kind === 'empty') await fs.rmdir(opts.out);
+      await fs.rename(staging, opts.out);
+    }
+  } catch (error) {
+    if (error instanceof NeoError) throw error; // swap 路径自带完整交代
+    // new/empty 换入失败:out 未受损 → 清掉暂存,只报失败。
+    await removeMaterializedTree(ports.link, staging).catch(() => undefined);
+    await fs.rm(staging, { recursive: true, force: true }).catch(() => undefined);
+    throw new NeoError(
+      'failure',
+      `materialize: rename into ${opts.out} failed (${(error as Error).message}); staging cleaned, out unchanged`,
+    );
+  }
+
+  // 清单:与渲染同一来源(convergeRoot 报告的 skillSources = default ∪ role 胜者),
+  // hash 复用技能内容哈希约定;source = 胜出的装配层(角色名或 default)。
+  const skills: MaterializeSkillEntry[] = [];
+  for (const skill of report.skillSources) {
+    skills.push({
+      name: skill.name,
+      hash: await computeSkillFolderHash(skill.dir),
+      source: skill.role,
+    });
+  }
+  const body: Omit<MaterializeManifest, 'hash' | 'outDir' | 'ok'> = {
+    role: opts.role,
+    agent: opts.agent,
+    skills,
+    mcp: {
+      file: report.mcp.file === null ? null : path.relative(staging, report.mcp.file),
+      servers: report.mcp.servers,
+    },
+    model: {
+      file: report.models.file === null ? null : path.relative(staging, report.models.file),
+      providers: report.models.providers,
+      default: report.models.default,
+    },
+  };
+  return {
+    outDir: opts.out,
+    manifest: { ok: true, outDir: opts.out, ...body, hash: manifestHash(body) },
+  };
+}
