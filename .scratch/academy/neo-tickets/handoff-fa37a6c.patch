+// —— 树快照(diff 判据;root.json 的 createdAt 是唯一允许的时间戳差异)——
+
+interface TreeEntry {
+  rel: string;
+  kind: 'dir' | 'file' | 'link';
+  /** file:内容 sha256;link:readlink 原文;root.json:剥掉 createdAt 后的规范化 JSON。 */
+  digest: string;
+}
+
+const sha256 = async (bytes: Uint8Array | string): Promise<string> => {
+  const { createHash } = await import('node:crypto');
+  return createHash('sha256').update(bytes).digest('hex');
+};
+
+async function snapshotTree(root: string, prefix = ''): Promise<TreeEntry[]> {
+  const entries: TreeEntry[] = [];
+  for (const entry of await fs.readdir(root, { withFileTypes: true })) {
+    const abs = path.join(root, entry.name);
+    const rel = prefix.length === 0 ? entry.name : `${prefix}/${entry.name}`;
+    const info = await fs.lstat(abs);
+    if (info.isSymbolicLink()) {
+      entries.push({ rel, kind: 'link', digest: await fs.readlink(abs) });
+    } else if (info.isDirectory()) {
+      entries.push({ rel, kind: 'dir', digest: '' });
+      entries.push(...(await snapshotTree(abs, rel)));
+    } else {
+      const bytes = await fs.readFile(abs);
+      let digest: string;
+      if (rel === 'root.json') {
+        const meta = JSON.parse(bytes.toString('utf8')) as Record<string, unknown>;
+        digest = JSON.stringify({ ...meta, createdAt: '<any>' });
+      } else {
+        digest = await sha256(bytes);
+      }
+      entries.push({ rel, kind: 'file', digest });
+    }
+  }
+  return entries.sort((a, b) => (a.rel < b.rel ? -1 : a.rel > b.rel ? 1 : 0));
+}
+
+/** 整家目录快照:每路径 = 类型 + 内容摘要 + mtime;只读断言用(内容与 mtime 双双不变)。 */
+interface HomeEntry {
+  rel: string;
+  kind: 'dir' | 'file' | 'link';
+  digest: string;
+  mtimeNs: string;
+}
+
+async function snapshotHome(root: string, prefix = ''): Promise<HomeEntry[]> {
+  const entries: HomeEntry[] = [];
+  for (const entry of await fs.readdir(root, { withFileTypes: true })) {
+    const abs = path.join(root, entry.name);
+    const rel = prefix.length === 0 ? entry.name : `${prefix}/${entry.name}`;
+    // bigint:true 才带 mtimeNs(纳秒级 mtime,只读断言的精度判据)。
+    const info = await fs.lstat(abs, { bigint: true });
+    if (info.isSymbolicLink()) {
+      entries.push({ rel, kind: 'link', digest: await fs.readlink(abs), mtimeNs: info.mtimeNs.toString() });
+    } else if (info.isDirectory()) {
+      entries.push({ rel, kind: 'dir', digest: '', mtimeNs: info.mtimeNs.toString() });
+      entries.push(...(await snapshotHome(abs, rel)));
+    } else {
+      entries.push({
+        rel,
+        kind: 'file',
+        digest: await sha256(await fs.readFile(abs)),
+        mtimeNs: info.mtimeNs.toString(),
+      });
+    }
+  }
+  return entries.sort((a, b) => (a.rel < b.rel ? -1 : a.rel > b.rel ? 1 : 0));
+}
