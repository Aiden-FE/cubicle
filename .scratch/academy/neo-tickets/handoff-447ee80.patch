+
+  it('域名排序 + 技能计数;顶层散文件不计', async () => {
+    await makeDomain('web', ['pdf', 'docx']);
+    await makeDomain('data', []);
+    await fs.writeFile(path.join(home, 'library', 'README.md'), 'x\n', 'utf8');
+    expect(await listDomains(home)).toEqual([
+      { name: 'data', skills: 0, usedBy: [] },
+      { name: 'web', skills: 2, usedBy: [] },
