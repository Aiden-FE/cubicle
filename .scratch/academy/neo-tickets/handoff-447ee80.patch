index 0000000..beebefc
--- /dev/null
+++ b/packages/core/src/assembly.ts
@@ -0,0 +1,104 @@
+import fs from 'node:fs/promises';
+import path from 'node:path';
+import { readRoleDomains } from './library.js';
+import { domainDir, roleSkillsDir } from './paths.js';
+
+/**
+ * 装配内核(academy 票 02):`default ∪ domain(角色的所有领域) ∪ role`,
+ * 同名以更近者胜(`role > domain > default`)。converge(全局挂载)、roots(启动根)、
+ * status(对账)共用这一份裁决,规则绝不允许在调用点二次实现(规则分叉只在特定
+ * 角色组合下显形,极难查——见 academy spec「为什么 Neo 要动」)。
+ *
+ * - `library/` 不存在或角色无 role.yaml 时,结果与旧的 `default ∪ role` 完全一致;
+ * - 多领域 = 技能并集去重;一个技能可同时属于多个 domain;
+ * - domain 层内部同名(两个 domain 都有该技能):按域名字典序前者胜,败者入 losers
+ *   (装配键只到 domain 层,再细的优先级没有可读语义,字典序只求确定性);
+ * - role = `default` 时 default 目录同时坐在底座与角色位(default 自声明的 domain 仍输给它)。
+ */
+
+export type SkillLayer = 'default' | 'domain' | 'role';
+
+export interface SkillSource {
+  layer: SkillLayer;
+  /** 容器名:default 层/role 层 = 角色名,domain 层 = 领域名。 */
+  container: string;
+  /** 技能内容目录(roles/<c>/skills/<name> 或 library/<c>/<name>)。 */
+  dir: string;
+}
+
+export interface SkillResolution {
+  name: string;
+  winner: SkillSource;
+  /** 同名落选来源,按「离胜者更近」排序(层优先级降序、同层按容器名);供 status 裁决可读。 */
+  losers: SkillSource[];
+}
+
+export interface RoleAssembly {
+  role: string;
+  /** 角色声明的领域(声明序去重,来自 role.yaml;缺文件 = [])。 */
+  domains: string[];
+  resolutions: Map<string, SkillResolution>;
+}
+
+/** 装配层标签:`default` / 角色名 / `domain:<领域名>`(报告与清单的可读来源标识)。 */
+export function layerLabel(source: SkillSource): string {
+  return source.layer === 'domain' ? `domain:${source.container}` : source.container;
+}
+
+/** 一层技能目录:子目录名即技能名(与旧实现一致:目录与符号链接都算,散文件不计)。 */
+async function layerSkillSources(
+  home: string,
+  layer: SkillLayer,
+  container: string,
+): Promise<Map<string, SkillSource>> {
+  const base = layer === 'domain' ? domainDir(home, container) : roleSkillsDir(home, container);
+  const out = new Map<string, SkillSource>();
+  try {
+    const entries = await fs.readdir(base, { withFileTypes: true });
+    for (const entry of entries) {
+      if (!entry.isDirectory() && !entry.isSymbolicLink()) continue;
+      out.set(entry.name, { layer, container, dir: path.join(base, entry.name) });
+    }
+  } catch (error) {
+    if ((error as NodeJS.ErrnoException).code !== 'ENOENT') throw error;
+  }
+  return out;
+}
+
+const LAYER_RANK: Record<SkillLayer, number> = { default: 0, domain: 1, role: 2 };
+
+export async function resolveRoleAssembly(home: string, role: string): Promise<RoleAssembly> {
+  const domains = await readRoleDomains(home, role);
+  // 装配栈自底向上:default 底座 → 各 domain(按域名字典序,保证确定性)→ 角色层。
+  // role = default 时角色位仍是 default 目录本身(它坐在最外圈,胜过自声明的 domain)。
+  const stack: { layer: SkillLayer; container: string }[] = [
+    { layer: 'default', container: 'default' },
+    ...[...domains].sort().map((domain) => ({ layer: 'domain' as const, container: domain })),
+    { layer: 'role', container: role },
+  ];
+
+  const winners = new Map<string, SkillSource>();
+  const seen = new Map<string, SkillSource[]>();
+  for (const frame of stack) {
+    for (const [name, source] of await layerSkillSources(home, frame.layer, frame.container)) {
+      const current = winners.get(name);
+      // 更近层覆盖同名;同层(domain 并列)先位胜 = 字典序前者胜。
+      if (current === undefined || LAYER_RANK[frame.layer] > LAYER_RANK[current.layer]) {
+        winners.set(name, source);
+      }
+      seen.set(name, [...(seen.get(name) ?? []), source]);
+    }
+  }
+
+  const resolutions = new Map<string, SkillResolution>();
+  for (const [name, winner] of winners) {
+    const losers = (seen.get(name) ?? [])
+      .filter((source) => source.dir !== winner.dir)
+      .sort((a, b) =>
+        LAYER_RANK[b.layer] - LAYER_RANK[a.layer] ||
+        (a.container < b.container ? -1 : a.container > b.container ? 1 : 0),
+      );
+    resolutions.set(name, { name, winner, losers });
+  }
+  return { role, domains, resolutions };
+}
