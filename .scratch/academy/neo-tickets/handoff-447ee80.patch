+++ b/.scratch/academy/evidence/foreign-library.ts.2026-11-17-2
@@ -0,0 +1,132 @@
+import fs from 'node:fs/promises';
+import { parse } from 'yaml';
+import { NeoError } from './error.js';
+import { ROLE_NAME_PATTERN, validateDomainName } from './names.js';
+import { domainDir, libraryDir, roleYamlPath, rolesDir } from './paths.js';
+import { isRecord } from './record.js';
+
+/**
+ * 领域资源库(academy 票 02;schema `library/<domain>/<skill>/`)。
+ *
+ * - 领域 = 跨角色的装配键:角色用 `roles/<role>/role.yaml` 声明 `domains: [...]`,
+ *   缺文件 = 无领域(兼容硬要求:library/ 与 role.yaml 缺席时一切照旧)。
+ * - `default` 不是领域:它是装配的底座层本身,`role.yaml` 里 default 不得声明领域
+ *   (否则等于凭空造第二个底座,装配语义未定案)。
+ * - 装配顺序与裁决在 assembly.ts;本模块只做名字规则、role.yaml 读取与 library 清单。
+ */
+
+export { validateDomainName };
+
+function invalidRoleYaml(role: string, message: string): NeoError {
+  return new NeoError('state', `role "${role}" role.yaml: ${message}`);
+}
+
+/**
+ * 读角色的领域声明(role.yaml 的 `domains`);缺文件/空文件/无字段 → []。
+ * 非法 YAML、更高版本、非法/重复条目、default 自身声明领域 → state 错(拒绝,不静默)。
+ */
+export async function readRoleDomains(home: string, role: string): Promise<string[]> {
+  let text: string;
+  try {
+    text = await fs.readFile(roleYamlPath(home, role), 'utf8');
+  } catch (error) {
+    if ((error as NodeJS.ErrnoException).code === 'ENOENT') return [];
+    throw error;
+  }
+  let raw: unknown;
+  try {
+    raw = parse(text);
+  } catch (error) {
+    throw invalidRoleYaml(role, `not valid YAML (${(error as Error).message})`);
+  }
+  if (raw === null || raw === undefined) return [];
+  if (!isRecord(raw)) throw invalidRoleYaml(role, 'expected a top-level mapping');
+  const version = raw.version;
+  if (version !== undefined && version !== 1) {
+    throw invalidRoleYaml(role, `unsupported version ${String(version)} (supported: 1)`);
+  }
+  if (raw.domains === undefined) return [];
+  if (!Array.isArray(raw.domains)) {
+    throw invalidRoleYaml(role, '"domains" must be a list of domain names');
+  }
+  const out: string[] = [];
+  for (const item of raw.domains) {
+    if (typeof item !== 'string' || !ROLE_NAME_PATTERN.test(item) || item === 'default') {
+      throw invalidRoleYaml(
+        role,
+        `domains entry ${JSON.stringify(item)} is not a valid domain name ` +
+          `(must match ${ROLE_NAME_PATTERN.source}; "default" is the base layer, not a domain)`,
+      );
+    }
+    if (out.includes(item)) {
+      throw invalidRoleYaml(role, `domains entry ${JSON.stringify(item)} is duplicated`);
+    }
+    out.push(item);
+  }
+  if (role === 'default' && out.length > 0) {
+    throw invalidRoleYaml(role, 'default is the base layer and must not declare domains');
+  }
+  return out;
+}
+
+/** library/ 下的领域目录名(排序;library/ 不存在 → 空,不是错误)。 */
+export async function domainNames(home: string): Promise<string[]> {
+  try {
+    const entries = await fs.readdir(libraryDir(home), { withFileTypes: true });
+    return entries
+      .filter((entry) => entry.isDirectory())
+      .map((entry) => entry.name)
+      .sort();
+  } catch (error) {
+    if ((error as NodeJS.ErrnoException).code === 'ENOENT') return [];
+    throw error;
+  }
+}
+
+export interface DomainSummary {
+  name: string;
+  /** 领域内技能目录数(散文件不计)。 */
+  skills: number;
+  /** 声明了该领域的角色(排序;default 不可能声明)。 */
+  usedBy: string[];
+}
+
+/** `neo list domains` 数据:每领域技能数 + 引用它的角色;空库 → 空表(不是错误)。 */
+export async function listDomains(home: string): Promise<DomainSummary[]> {
+  const domains = await domainNames(home);
+  const roleDirs = await declaredRoles(home);
+  const usage = new Map<string, string[]>();
+  for (const role of roleDirs) {
+    if (role === 'default') continue;
+    for (const domain of await readRoleDomains(home, role)) {
+      usage.set(domain, [...(usage.get(domain) ?? []), role]);
+    }
+  }
+  return Promise.all(
+    domains.map(async (name) => ({
+      name,
+      skills: await domainSkillCount(home, name),
+      usedBy: (usage.get(name) ?? []).sort(),
+    })),
+  );
+}
+
+async function domainSkillCount(home: string, domain: string): Promise<number> {
+  try {
+    const entries = await fs.readdir(domainDir(home, domain), { withFileTypes: true });
+    return entries.filter((entry) => entry.isDirectory() || entry.isSymbolicLink()).length;
+  } catch (error) {
+    if ((error as NodeJS.ErrnoException).code === 'ENOENT') return 0;
+    throw error;
+  }
+}
+
+async function declaredRoles(home: string): Promise<string[]> {
+  try {
+    const entries = await fs.readdir(rolesDir(home), { withFileTypes: true });
+    return entries.filter((entry) => entry.isDirectory()).map((entry) => entry.name);
+  } catch (error) {
+    if ((error as NodeJS.ErrnoException).code === 'ENOENT') return [];
+    throw error;
+  }
+}
