+    await writeRoleYaml('work', 'version: 1\ndomains: "web"\n');
+    await expect(readRoleDomains(home, 'work')).rejects.toThrow(/domains/);
+
+    await writeRoleYaml('work', 'version: 1\ndomains: [Bad Name]\n');
+    await expect(readRoleDomains(home, 'work')).rejects.toThrow(/Bad Name/);
+  });
+
+  it('空文件 = 损坏(与 locks 同规则)', async () => {
+    await writeRoleYaml('work', '');
+    await expect(readRoleDomains(home, 'work')).rejects.toThrow(/empty/);
+  });
+
+  it('default 声明领域 → state 错(default 是装配底座层,不是领域消费者)', async () => {
+    await writeRoleYaml('default', 'version: 1\ndomains: [web]\n');
+    await expect(readRoleDomains(home, 'default')).rejects.toThrow(/default/);
+    await writeRoleYaml('default', 'version: 1\n');
+    expect(await readRoleDomains(home, 'default')).toEqual([]);
+  });
+});
+
+describe('validateDomainName', () => {
+  it('角色名规则 + default 保留(装配缺省层不是领域)', () => {
+    validateDomainName('frontend');
+    validateDomainName('a1-2');
+    expect(() => validateDomainName('Default')).toThrow(/domain name/);
+    expect(() => validateDomainName('bad name')).toThrow(/domain name/);
+    expect(() => validateDomainName('default')).toThrow(/reserved/);
+  });
+});
+
+describe('listDomains(~/.neo/library)', () => {
+  async function makeDomain(domain: string, skills: readonly string[]): Promise<void> {
+    await fs.mkdir(domainDir(home, domain), { recursive: true });
+    for (const skill of skills) {
+      const dir = path.join(domainDir(home, domain), skill);
+      await fs.mkdir(dir, { recursive: true });
+      await fs.writeFile(path.join(dir, 'SKILL.md'), `domain=${domain}\n`, 'utf8');
+    }
+  }
+
+  it('library/ 不存在 → 空清单(不报错)', async () => {
+    expect(await listDomains(home)).toEqual([]);
+  });
+
+  it('空 library/ → 空清单', async () => {
+    await fs.mkdir(path.join(home, 'library'), { recursive: true });
+    expect(await listDomains(home)).toEqual([]);
