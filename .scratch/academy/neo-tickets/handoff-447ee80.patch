+import fs from 'node:fs/promises';
+import path from 'node:path';
+import { parse } from 'yaml';
+import { NeoError } from './error.js';
+import { libraryDir, roleYamlPath } from './paths.js';
+import { ROLE_NAME_PATTERN, validateDomainName } from './names.js';
+import { isRecord } from './record.js';
+
+/**
+ * 领域(academy 票 02):`library/<domain>/<skill>/` 承载跨角色共享技能;
+ * 角色用 `roles/<role>/role.yaml` 声明 `domains: [...]`(缺文件 = 无领域)。
+ *
+ * role.yaml 是 neo 持有文件,按 schema §7 带独立 version:
+ * 缺文件 → 无领域;空文件/损坏/更高主版本 → state 错(拒绝读写,绝不静默当无领域)。
+ * 域名规则沿用角色名(§1),`default` 保留——装配里的 default 是底座角色层。
+ */
+
+export { validateDomainName };
+
+function corrupt(role: string, message: string): NeoError {
+  return new NeoError(
+    'state',
+    `role "${role}" role.yaml is corrupt (${message}); refusing to read or write`,
+  );
+}
+
+/**
+ * 读角色的领域声明;缺文件 → [];按声明序去重。
+ * 损坏 / 更高主版本 / 域名非法 → state 错(§7)。
+ */
+export async function readRoleDomains(home: string, role: string): Promise<string[]> {
+  let text: string;
+  try {
+    text = await fs.readFile(roleYamlPath(home, role), 'utf8');
+  } catch (error) {
+    if ((error as NodeJS.ErrnoException).code === 'ENOENT') return [];
+    throw error;
+  }
+
+  let raw: unknown;
+  try {
+    raw = parse(text);
+  } catch (error) {
+    throw corrupt(role, `not valid YAML: ${(error as Error).message}`);
+  }
+  if (raw === null || raw === undefined) throw corrupt(role, 'file is empty');
+  if (!isRecord(raw)) throw corrupt(role, 'expected a top-level mapping');
+
+  if (raw.version === undefined) throw corrupt(role, 'missing required field "version"');
+  if (raw.version !== 1) {
+    throw corrupt(role, `unsupported version ${String(raw.version)} (supported major version: 1)`);
+  }
+  if (raw.domains === undefined) return [];
+  if (!Array.isArray(raw.domains)) throw corrupt(role, '"domains" must be a list of strings');
+
+  const seen = new Set<string>();
+  const domains: string[] = [];
+  for (const item of raw.domains) {
+    if (typeof item !== 'string' || !ROLE_NAME_PATTERN.test(item) || item === 'default') {
+      throw corrupt(role, `domains entry ${JSON.stringify(item)} is not a valid domain name`);
+    }
+    if (seen.has(item)) continue;
+    seen.add(item);
+    domains.push(item);
+  }
+  return domains;
+}
+
+export interface DomainSummary {
+  name: string;
+  /** domain 目录下的技能子目录数(散文件不计)。 */
+  skills: number;
+}
+
+/** library/ 领域清单(名排序);library/ 不存在或为空 → 空数组,不报错。 */
+export async function listDomains(home: string): Promise<DomainSummary[]> {
+  const out: DomainSummary[] = [];
+  let entries: import('node:fs').Dirent[];
+  try {
+    entries = await fs.readdir(libraryDir(home), { withFileTypes: true });
+  } catch (error) {
+    if ((error as NodeJS.ErrnoException).code === 'ENOENT') return [];
+    throw error;
+  }
+  for (const entry of entries.filter((item) => item.isDirectory()).sort((a, b) => (a.name < b.name ? -1 : 1))) {
+    let skills = 0;
+    try {
+      const inner = await fs.readdir(path.join(libraryDir(home), entry.name), { withFileTypes: true });
+      skills = inner.filter((item) => item.isDirectory()).length;
+    } catch (error) {
+      if ((error as NodeJS.ErrnoException).code !== 'ENOENT') throw error;
+    }
+    out.push({ name: entry.name, skills });
+  }
+  return out;
+}
