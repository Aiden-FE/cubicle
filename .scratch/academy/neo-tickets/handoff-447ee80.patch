+import { describe, expect, it, beforeEach, afterEach } from 'vitest';
+import fs from 'node:fs/promises';
+import os from 'node:os';
+import path from 'node:path';
+import { NeoError } from './error.js';
+import { domainNames, listDomains, readRoleDomains, validateDomainName } from './library.js';
+
+/**
+ * academy 票 02 接缝:library/<domain>/<skill> 资源库与 role.yaml 领域声明的读取规则。
+ * 临时 NEO_HOME,绝不触真实 ~/.neo。
+ */
+
+let home: string;
+beforeEach(async () => {
+  home = await fs.mkdtemp(path.join(os.tmpdir(), 'neo-library-test-'));
+});
+afterEach(async () => {
+  await fs.rm(home, { recursive: true, force: true });
+});
+
+const writeRoleYaml = async (role: string, text: string): Promise<void> => {
+  await fs.mkdir(path.join(home, 'roles', role), { recursive: true });
+  await fs.writeFile(path.join(home, 'roles', role, 'role.yaml'), text, 'utf8');
+};
+
+const makeDomain = async (domain: string, skills: string[]): Promise<void> => {
+  for (const skill of skills) {
+    await fs.mkdir(path.join(home, 'library', domain, skill), { recursive: true });
+  }
+};
+
+describe('validateDomainName(领域名规则)', () => {
+  it('合法域名与角色名同规则', () => {
+    expect(() => validateDomainName('frontend')).not.toThrow();
+    expect(() => validateDomainName('a1-2')).not.toThrow();
+  });
+  it('非法形态 → usage 错', () => {
+    for (const bad of ['Frontend', '', 'has space', '-lead', 'x'.repeat(65)]) {
+      expect(() => validateDomainName(bad), bad).toThrow(NeoError);
+      try {
+        validateDomainName(bad);
+      } catch (error) {
+        expect((error as NeoError).kind, bad).toBe('usage');
+      }
+    }
+  });
+  it('default 不是域名(它是全局底座层,不是领域)', () => {
+    expect(() => validateDomainName('default')).toThrow(/default/);
+  });
+});
+
+describe('readRoleDomains(role.yaml 领域声明)', () => {
+  it('缺文件 = 无领域(兼容硬要求:library/role.yaml 缺席一切照旧)', async () => {
+    await fs.mkdir(path.join(home, 'roles', 'dev'), { recursive: true });
+    expect(await readRoleDomains(home, 'dev')).toEqual([]);
+  });
+  it('解析 domains 列表并保留声明顺序', async () => {
+    await writeRoleYaml('dev', 'domains: [frontend, shared]\n');
+    expect(await readRoleDomains(home, 'dev')).toEqual(['frontend', 'shared']);
+  });
+  it('空文件 / 无 domains 字段 → []', async () => {
+    await writeRoleYaml('a', '');
+    expect(await readRoleDomains(home, 'a')).toEqual([]);
+    await writeRoleYaml('b', 'version: 1\n');
+    expect(await readRoleDomains(home, 'b')).toEqual([]);
+  });
+  it('非法 YAML / 更高版本 / 非法条目 → state 错(拒绝,不静默)', async () => {
+    await writeRoleYaml('bad1', 'domains: [a, [broken\n');
+    await expect(readRoleDomains(home, 'bad1')).rejects.toThrow(NeoError);
+    await writeRoleYaml('bad2', 'version: 2\ndomains: [a]\n');
+    await expect(readRoleDomains(home, 'bad2')).rejects.toThrow(/version/);
+    await writeRoleYaml('bad3', 'domains: [Frontend]\n');
+    await expect(readRoleDomains(home, 'bad3')).rejects.toThrow(/Frontend/);
+    await writeRoleYaml('bad4', 'domains: default\n');
+    await expect(readRoleDomains(home, 'bad4')).rejects.toThrow(/domains/);
+  });
+});
+
+describe('domainNames / listDomains(library/ 清单)', () => {
+  it('library/ 不存在 → 空(不是错误)', async () => {
+    expect(await domainNames(home)).toEqual([]);
+    expect(await listDomains(home)).toEqual([]);
+  });
+  it('按名排序;每个领域报技能数与引用角色', async () => {
+    await makeDomain('shared', ['pdf', 'docx']);
+    await makeDomain('frontend', []);
+    await writeRoleYaml('web', 'domains: [frontend, shared]\n');
+    await writeRoleYaml('docs', 'domains: [shared]\n');
+    expect(await domainNames(home)).toEqual(['frontend', 'shared']);
+    expect(await listDomains(home)).toEqual([
+      { name: 'frontend', skills: 0, usedBy: ['web'] },
+      { name: 'shared', skills: 2, usedBy: ['docs', 'web'] },
+    ]);
+  });
+  it('散文件不计技能;default 角色声明领域 → state 错(default 是底座层,不是领域消费者)', async () => {
+    await makeDomain('shared', ['pdf']);
+    await fs.writeFile(path.join(home, 'library', 'shared', 'README.md'), 'x', 'utf8');
+    await writeRoleYaml('default', 'domains: [shared]\n');
+    await expect(readRoleDomains(home, 'default')).rejects.toThrow(/default/);
+    expect(await listDomains(home)).toEqual([{ name: 'shared', skills: 1, usedBy: [] }]);
+  });
+});
