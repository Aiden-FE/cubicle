--- /dev/null
+++ b/.scratch/academy/evidence/foreign-library.test.ts.2026-11-17-3
@@ -0,0 +1,131 @@
+import { describe, expect, it, beforeEach, afterEach } from 'vitest';
+import fs from 'node:fs/promises';
+import os from 'node:os';
+import path from 'node:path';
+import { listDomains, readRoleDomains, validateDomainName } from './library.js';
+import { domainDir, roleYamlPath } from './paths.js';
+
+/**
+ * academy 票 02:role.yaml 的领域声明(缺文件 = 无领域)与 library/ 领域清单。
+ * 读写规则沿用 schema §7:更高主版本 → 拒绝;损坏 → 拒绝,不静默当"无领域"。
+ */
+
+let tmp: string;
+let home: string;
+
+beforeEach(async () => {
+  tmp = await fs.mkdtemp(path.join(os.tmpdir(), 'neo-domains-'));
+  home = path.join(tmp, 'neo');
+  await fs.mkdir(home, { recursive: true });
+});
+afterEach(async () => {
+  await fs.rm(tmp, { recursive: true, force: true });
+});
+
+async function writeRoleYaml(role: string, text: string): Promise<void> {
+  const file = roleYamlPath(home, role);
+  await fs.mkdir(path.dirname(file), { recursive: true });
+  await fs.writeFile(file, text, 'utf8');
+}
+
+describe('readRoleDomains(roles/<role>/role.yaml)', () => {
+  it('缺 role.yaml = 无领域(空数组)', async () => {
+    expect(await readRoleDomains(home, 'work')).toEqual([]);
+  });
+
+  it('domains 列表按声明序去重返回', async () => {
+    await writeRoleYaml(
+      'work',
+      'version: 1\ndomains: [frontend, backend, frontend]\n',
+    );
+    expect(await readRoleDomains(home, 'work')).toEqual(['frontend', 'backend']);
+  });
+
+  it('只有 version、无 domains 字段 = 无领域', async () => {
+    await writeRoleYaml('work', 'version: 1\n');
+    expect(await readRoleDomains(home, 'work')).toEqual([]);
+  });
+
+  it('未知字段不影响读取(round-trip 归写侧;读侧只取 domains)', async () => {
+    await writeRoleYaml('work', 'version: 1\nfuture: {a: 1}\ndomains: [web]\n');
+    expect(await readRoleDomains(home, 'work')).toEqual(['web']);
+  });
+
+  it('更高主版本 → state 错(拒绝读写,schema §7)', async () => {
+    await writeRoleYaml('work', 'version: 2\ndomains: [web]\n');
+    await expect(readRoleDomains(home, 'work')).rejects.toThrow(/version 2/);
+  });
+
+  it('损坏(YAML 语法/形状不合法/域名非法)→ state 错,绝不静默当无领域', async () => {
+    await writeRoleYaml('work', 'version: 1\ndomains: [oops\n');
+    await expect(readRoleDomains(home, 'work')).rejects.toThrow(/role\.yaml/);
+
+    await writeRoleYaml('work', 'version: 1\ndomains: "web"\n');
+    await expect(readRoleDomains(home, 'work')).rejects.toThrow(/domains/);
+
+    await writeRoleYaml('work', 'version: 1\ndomains: [Bad Name]\n');
+    await expect(readRoleDomains(home, 'work')).rejects.toThrow(/Bad Name/);
+  });
+
+  it('空文件 = 损坏(与 locks 同规则)', async () => {
+    await writeRoleYaml('work', '');
+    await expect(readRoleDomains(home, 'work')).rejects.toThrow(/empty/);
+  });
+
+  it('default 声明领域 → state 错(default 是装配底座层,不是领域消费者)', async () => {
+    await writeRoleYaml('default', 'version: 1\ndomains: [web]\n');
+    await expect(readRoleDomains(home, 'default')).rejects.toThrow(/default/);
+    await writeRoleYaml('default', 'version: 1\n');
+    expect(await readRoleDomains(home, 'default')).toEqual([]);
+  });
+});
+
+describe('validateDomainName', () => {
+  it('角色名规则 + default 保留(装配缺省层不是领域)', () => {
+    validateDomainName('frontend');
+    validateDomainName('a1-2');
+    expect(() => validateDomainName('Default')).toThrow(/domain name/);
+    expect(() => validateDomainName('bad name')).toThrow(/domain name/);
+    expect(() => validateDomainName('default')).toThrow(/reserved/);
+  });
+});
+
+describe('listDomains(~/.neo/library)', () => {
+  async function makeDomain(domain: string, skills: readonly string[]): Promise<void> {
+    await fs.mkdir(domainDir(home, domain), { recursive: true });
+    for (const skill of skills) {
+      const dir = path.join(domainDir(home, domain), skill);
+      await fs.mkdir(dir, { recursive: true });
+      await fs.writeFile(path.join(dir, 'SKILL.md'), `domain=${domain}\n`, 'utf8');
+    }
+  }
+
+  it('library/ 不存在 → 空清单(不报错)', async () => {
+    expect(await listDomains(home)).toEqual([]);
+  });
+
+  it('空 library/ → 空清单', async () => {
+    await fs.mkdir(path.join(home, 'library'), { recursive: true });
+    expect(await listDomains(home)).toEqual([]);
+  });
+
+  it('域名排序 + 技能计数;顶层散文件不计', async () => {
+    await makeDomain('web', ['pdf', 'docx']);
+    await makeDomain('data', []);
+    await fs.writeFile(path.join(home, 'library', 'README.md'), 'x\n', 'utf8');
+    expect(await listDomains(home)).toEqual([
+      { name: 'data', skills: 0, usedBy: [] },
+      { name: 'web', skills: 2, usedBy: [] },
+    ]);
+  });
+
+  it('usedBy = 声明该领域的角色(排序;default 不可能声明)', async () => {
+    await makeDomain('shared', ['pdf']);
+    await writeRoleYaml('web', 'version: 1\ndomains: [shared]\n');
+    await writeRoleYaml('docs', 'version: 1\ndomains: [shared]\n');
+    await writeRoleYaml('default', 'version: 1\n');
+    expect(await listDomains(home)).toEqual([
+      { name: 'shared', skills: 1, usedBy: ['docs', 'web'] },
+    ]);
+  });
+});
