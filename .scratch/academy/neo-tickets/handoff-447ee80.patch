+ * academy 票 02:role.yaml 的领域声明(缺文件 = 无领域)与 library/ 领域清单。
+ * 读写规则沿用 schema §7:更高主版本 → 拒绝;损坏 → 拒绝,不静默当"无领域"。
+ */
+
+let tmp: string;
+let home: string;
+
+beforeEach(async () => {
+  tmp = await fs.mkdtemp(path.join(os.tmpdir(), 'neo-domains-'));
+  home = path.join(tmp, 'neo');
+  await fs.mkdir(home, { recursive: true });
+});
+afterEach(async () => {
+  await fs.rm(tmp, { recursive: true, force: true });
+});
+
+async function writeRoleYaml(role: string, text: string): Promise<void> {
+  const file = roleYamlPath(home, role);
+  await fs.mkdir(path.dirname(file), { recursive: true });
+  await fs.writeFile(file, text, 'utf8');
+}
+
+describe('readRoleDomains(roles/<role>/role.yaml)', () => {
+  it('缺 role.yaml = 无领域(空数组)', async () => {
+    expect(await readRoleDomains(home, 'work')).toEqual([]);
+  });
+
+  it('domains 列表按声明序去重返回', async () => {
+    await writeRoleYaml(
+      'work',
+      'version: 1\ndomains: [frontend, backend, frontend]\n',
+    );
+    expect(await readRoleDomains(home, 'work')).toEqual(['frontend', 'backend']);
+  });
+
+  it('只有 version、无 domains 字段 = 无领域', async () => {
+    await writeRoleYaml('work', 'version: 1\n');
+    expect(await readRoleDomains(home, 'work')).toEqual([]);
+  });
+
+  it('未知字段不影响读取(round-trip 归写侧;读侧只取 domains)', async () => {
+    await writeRoleYaml('work', 'version: 1\nfuture: {a: 1}\ndomains: [web]\n');
