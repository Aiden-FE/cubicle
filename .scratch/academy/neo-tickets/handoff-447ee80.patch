+import { describe, expect, it, beforeEach, afterEach } from 'vitest';
+import fs from 'node:fs/promises';
+import os from 'node:os';
+import path from 'node:path';
+import { layerLabel, resolveRoleAssembly, type SkillResolution } from './assembly.js';
+import { domainDir, roleSkillsDir } from './paths.js';
+
+/**
+ * academy 票 02:装配内核 —— default ∪ domain(角色的所有领域) ∪ role,
+ * 同名以更近者胜(role > domain > default);library/ 缺席时与旧 `default ∪ role` 完全一致。
+ * 多领域 = 并集去重;同技能可属多领域(domain 层并列,按域名字典序定胜负,输者入 losers)。
+ */
+
+let tmp: string;
+let home: string;
+
+beforeEach(async () => {
+  tmp = await fs.mkdtemp(path.join(os.tmpdir(), 'neo-assembly-'));
+  home = path.join(tmp, 'neo');
+  await fs.mkdir(home, { recursive: true });
+});
+afterEach(async () => {
+  await fs.rm(tmp, { recursive: true, force: true });
+});
+
+async function makeSkill(dir: string, name: string, marker: string): Promise<void> {
+  const target = path.join(dir, name);
+  await fs.mkdir(target, { recursive: true });
+  await fs.writeFile(path.join(target, 'SKILL.md'), marker, 'utf8');
+}
+
+const roleDir = (role: string) => roleSkillsDir(home, role);
+const makeRole = (role: string, skills: readonly string[]) =>
+  Promise.all(skills.map((s) => makeSkill(roleDir(role), s, `role=${role}\n`)));
+const makeDomain = (domain: string, skills: readonly string[]) =>
+  Promise.all(skills.map((s) => makeSkill(domainDir(home, domain), s, `domain=${domain}\n`)));
+
+async function setDomains(role: string, domains: readonly string[]): Promise<void> {
+  const dir = path.join(home, 'roles', role);
+  await fs.mkdir(dir, { recursive: true });
+  await fs.writeFile(path.join(dir, 'role.yaml'), `version: 1\ndomains: [${domains.join(', ')}]\n`, 'utf8');
+}
+
+const winnerOf = (r: SkillResolution): string => layerLabel(r.winner);
+
+describe('resolveRoleAssembly:兼容硬要求(library 缺席 = 旧语义)', () => {
+  it('无 library、无 role.yaml:default ∪ role,同名 role 胜;无 losers', async () => {
+    await makeRole('default', ['pdf', 'shared']);
+    await makeRole('work', ['docx', 'shared']);
+    const assembly = await resolveRoleAssembly(home, 'work');
+    expect(assembly.domains).toEqual([]);
+    expect([...assembly.resolutions.keys()].sort()).toEqual(['docx', 'pdf', 'shared']);
+    expect(winnerOf(assembly.resolutions.get('shared')!)).toBe('work');
+    expect(winnerOf(assembly.resolutions.get('pdf')!)).toBe('default');
+    expect(assembly.resolutions.get('shared')!.losers).toHaveLength(1);
+    expect(assembly.resolutions.get('pdf')!.losers).toEqual([]);
+    expect(assembly.resolutions.get('docx')!.winner.dir).toBe(path.join(roleDir('work'), 'docx'));
+  });
+
+  it('role = default 时只有一层(与今天一致)', async () => {
+    await makeRole('default', ['pdf']);
+    const assembly = await resolveRoleAssembly(home, 'default');
+    expect(winnerOf(assembly.resolutions.get('pdf')!)).toBe('default');
+    expect(assembly.resolutions.get('pdf')!.losers).toEqual([]);
+  });
+
+  it('role.yaml 引用不存在的 domain:不报错,只是没有内容可装配', async () => {
+    await makeRole('work', ['docx']);
+    await setDomains('work', ['ghost']);
+    const assembly = await resolveRoleAssembly(home, 'work');
+    expect(assembly.domains).toEqual(['ghost']);
+    expect([...assembly.resolutions.keys()]).toEqual(['docx']);
