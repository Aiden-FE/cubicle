@@ -0,0 +1,218 @@
+import fs from 'node:fs/promises';
+import path from 'node:path';
+import { NeoError } from './error.js';
+import { existsDir, writeFileAtomic } from './fs-util.js';
+import { normalizeRoleYaml, renderRoleYaml } from './library.js';
+import { isLockDirty, markRoleLockDirty, readRoleLock } from './locks.js';
+import { validateMcpForWrite } from './mcp.js';
+import { validateDomainName, validateRoleName } from './names.js';
+import { roleAgentsMd, roleDir, roleMcpPath, roleYamlPath } from './paths.js';
+
+/**
+ * 角色写入(academy 票 03):`neo role set` 的领域接缝 = setRoleAssembly()。
+ * create 只会写 stub,写入面(AGENTS.md 正文 / role.yaml 领域 / mcp.yaml)在这里;一次可改多项。
+ *
+ * - **一切校验在任何落盘之前**:角色存在性(未知 → state)、名字规则(usage)、
+ *   mcp.yaml 形状与敏感值(复用 mcp.ts 同一份解析/名单,不二次发明)、锁可读性(损坏 → state)。
+ * - 落盘恒「暂存 + rename」(writeFileAtomic);内容相同 = unchanged,不重写。
+ *   role.yaml 按 **canonical 形式** 比较(flow/block 风格差 = 同一声明,不重写不标脏)。
+ * - `domains: []` = 文件保留 + domains 置空(空字节 role.yaml 是损坏态,不是「清空」)。
+ * - 装配确有改动 → 锁标脏(§5.2 顶层 `dirty: true`;无锁 → 建最小锁);
+ *   dry-run 只产出 unified diff,零落盘,`dirty` 报「将要变脏」的预览。
+ */
+
+export interface RoleSetInput {
+  role: string;
+  /** 给出 → 整体替换 `roles/<role>/AGENTS.md` 正文(文件/stdin 读入在 CLI 层)。 */
+  agentsMd?: string;
+  /** 给出 → 覆写 role.yaml 的 domains;`[]` = 清空领域但保留文件。 */
+  domains?: readonly string[];
+  /** 给出 → 整体替换 `roles/<role>/mcp.yaml`(文本);敏感值只允许 `env:VAR` 引用。 */
+  mcp?: string;
+  /** 校验 + unified diff,零落盘。 */
+  dryRun?: boolean;
+}
+
+export interface RoleSetFileChange {
+  /** home 相对路径(`/` 分隔):报告与 diff 头共用。 */
+  file: string;
+  change: 'created' | 'updated' | 'unchanged';
+  /** 人可读 unified diff(unchanged → 空串)。 */
+  diff: string;
+}
+
+export interface RoleSetResult {
+  role: string;
+  dryRun: boolean;
+  /** 逐项:该项是否实际改动了内容(给出输入但未改动 = false)。 */
+  changed: { agentsMd: boolean; domains: boolean; mcp: boolean };
+  /** 每个给出的输入项一条,按写入序(agentsMd → domains → mcp)。 */
+  files: RoleSetFileChange[];
+  /** 本次操作后锁是否为脏(dry-run = 若提交将是的态)。 */
+  dirty: boolean;
+}
+
+async function readTextOrNull(file: string): Promise<string | null> {
+  try {
+    return await fs.readFile(file, 'utf8');
+  } catch (error) {
+    if ((error as NodeJS.ErrnoException).code === 'ENOENT') return null;
+    throw error;
+  }
+}
+
+const homeLabel = (home: string, file: string): string =>
+  path.relative(home, file).split(path.sep).join('/');
+
+interface Target {
+  key: 'agentsMd' | 'domains' | 'mcp';
+  file: string;
+  newText: string;
+  /** unchanged 判定的比较基准(domains 用 canonical 形式,其余用字节)。 */
+  compareBase: string | null;
+}
+
+export async function setRoleAssembly(home: string, input: RoleSetInput): Promise<RoleSetResult> {
+  const dryRun = input.dryRun === true;
+  validateRoleName(input.role);
+  if (input.role !== 'default' && !(await existsDir(roleDir(home, input.role)))) {
+    throw new NeoError(
+      'state',
+      `role "${input.role}" does not exist (create it first: neo create ${input.role})`,
+    );
+  }
+  if (input.domains !== undefined) {
+    for (const domain of input.domains) validateDomainName(domain);
+  }
+  // mcp 写前校验:形状与读盘同一份解析(mcp.ts)+ 写侧敏感键闸(明文凭据 → state,不落盘)。
+  if (input.mcp !== undefined) validateMcpForWrite(input.role, input.mcp);
+
+  // 锁先读(任何落盘之前):损坏先失败,现脏态供 dirty 预览;标脏在提交阶段最后做。
+  const lock = await readRoleLock(home, input.role);
+
+  // 待写目标先全部渲染/校验完(损坏 role.yaml 等也在第一个字节落盘前挡下)。
+  const targets: Target[] = [];
+  if (input.agentsMd !== undefined) {
+    targets.push({ key: 'agentsMd', file: roleAgentsMd(home, input.role), newText: input.agentsMd, compareBase: null });
+  }
+  if (input.domains !== undefined) {
+    const file = roleYamlPath(home, input.role);
+    const existing = await readTextOrNull(file);
+    targets.push({
+      key: 'domains',
+      file,
+      newText: renderRoleYaml(input.role, existing, input.domains),
+      compareBase: existing === null ? null : normalizeRoleYaml(input.role, existing),
+    });
+  }
+  if (input.mcp !== undefined) {
+    targets.push({ key: 'mcp', file: roleMcpPath(home, input.role), newText: input.mcp, compareBase: null });
+  }
+
+  const files: RoleSetFileChange[] = [];
+  const changed: RoleSetResult['changed'] = { agentsMd: false, domains: false, mcp: false };
+  for (const target of targets) {
+    const oldText = await readTextOrNull(target.file);
+    const oldCmp = target.compareBase ?? oldText;
+    const change: RoleSetFileChange['change'] =
+      oldCmp === null ? 'created' : oldCmp === target.newText ? 'unchanged' : 'updated';
+    const diff =
+      change === 'unchanged' ? '' : unifiedDiff(homeLabel(home, target.file), oldText ?? '', target.newText);
+    files.push({ file: homeLabel(home, target.file), change, diff });
+    if (change !== 'unchanged') {
+      changed[target.key] = true;
+      if (!dryRun) await writeFileAtomic(target.file, target.newText);
+    }
+  }
+
+  const assemblyChanged = Object.values(changed).some(Boolean);
+  const dirty = isLockDirty(lock) || assemblyChanged;
+  // 标脏 = 锁的最后一次改动;幂等与最小台账由 locks.ts 单点实现(已脏不重写)。
+  if (!dryRun && assemblyChanged) await markRoleLockDirty(home, input.role, lock);
+
+  return { role: input.role, dryRun, changed, files, dirty };
+}
+
+// —— unified diff(LCS 行差;3 行上下文;显示用,不保证 git apply)——
+
+const DIFF_CONTEXT = 3;
+
+function splitDiffLines(text: string): string[] {
+  if (text.length === 0) return [];
+  const lines = text.split(/\r?\n/);
+  if (lines.length > 0 && lines[lines.length - 1] === '') lines.pop();
+  return lines;
+}
+
+/** 最小 unified diff:头部 `---/+++ label`,hunk `@@ -l,c +l,c @@`,±3 行上下文(模块内私用)。 */
+function unifiedDiff(label: string, oldText: string, newText: string): string {
+  if (oldText === newText) return '';
+  const a = splitDiffLines(oldText);
+  const b = splitDiffLines(newText);
+  const n = a.length;
+  const m = b.length;
+
+  const lcs: number[][] = Array.from({ length: n + 1 }, () => new Array<number>(m + 1).fill(0));
+  for (let i = n - 1; i >= 0; i--) {
+    const row = lcs[i] as number[];
+    const next = lcs[i + 1] as number[];
+    for (let j = m - 1; j >= 0; j--) {
+      row[j] = a[i] === b[j] ? (next[j + 1] as number) + 1 : Math.max(next[j] as number, row[j + 1] as number);
+    }
+  }
+
+  type Op = { kind: ' ' | '-' | '+'; line: string };
+  const ops: Op[] = [];
+  for (let i = 0, j = 0; i < n || j < m; ) {
+    if (i < n && j < m && a[i] === b[j]) {
+      ops.push({ kind: ' ', line: a[i] as string });
+      i++;
+      j++;
+    } else if (j >= m || (i < n && (lcs[i + 1]![j] as number) >= (lcs[i]![j + 1] as number))) {
+      ops.push({ kind: '-', line: a[i] as string });
+      i++;
+    } else {
+      ops.push({ kind: '+', line: b[j] as string });
+      j++;
+    }
+  }
+
+  // 变化点分组为 hunk(相距 ≤2×上下文则合并)。
+  const groups: { start: number; end: number }[] = [];
+  for (let idx = 0; idx < ops.length; idx++) {
+    if (ops[idx]!.kind === ' ') continue;
+    const start = Math.max(0, idx - DIFF_CONTEXT);
+    const end = Math.min(ops.length, idx + DIFF_CONTEXT + 1);
+    const prev = groups[groups.length - 1];
+    if (prev !== undefined && start <= prev.end) prev.end = Math.max(prev.end, end);
+    else groups.push({ start, end });
+  }
+
+  const body: string[] = [];
+  for (const group of groups) {
+    let oldBefore = 0;
+    let newBefore = 0;
+    for (let k = 0; k < group.start; k++) {
+      if (ops[k]!.kind !== '+') oldBefore++;
+      if (ops[k]!.kind !== '-') newBefore++;
+    }
+    let oldCount = 0;
+    let newCount = 0;
+    for (let k = group.start; k < group.end; k++) {
+      if (ops[k]!.kind !== '+') oldCount++;
+      if (ops[k]!.kind !== '-') newCount++;
+    }
+    body.push(
+      `@@ -${oldBefore + (oldCount > 0 ? 1 : 0)},${oldCount} +${newBefore + (newCount > 0 ? 1 : 0)},${newCount} @@`,
+    );
+    for (let k = group.start; k < group.end; k++) {
+      body.push(`${ops[k]!.kind}${ops[k]!.line}`);
+    }
+  }
+
+  const header = [
+    `--- ${oldText.length === 0 ? '/dev/null' : label}`,
+    `+++ ${newText.length === 0 ? '/dev/null' : label}`,
+  ];
+  return `${[...header, ...body].join('\n')}\n`;
+}
