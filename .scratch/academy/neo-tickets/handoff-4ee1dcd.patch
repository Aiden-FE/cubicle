+
+/**
+ * parseArgs 把 flag 后紧跟的 `-` 判为缺值("expects a value");
+ * 但 `--agents-md -` / `--mcp -` 是 stdin 哨兵形态,先在命令局部并成内联 `flag=-`。
+ */
+function absorbStdinDash(args: readonly string[]): string[] {
+  const out: string[] = [];
+  for (let i = 0; i < args.length; i++) {
+    const arg = args[i] as string;
+    if ((arg === '--agents-md' || arg === '--mcp') && args[i + 1] === '-') {
+      out.push(`${arg}=-`);
+      i++;
+      continue;
+    }
+    out.push(arg);
+  }
+  return out;
+}
+
+async function readStdinAll(): Promise<string> {
+  const chunks: Buffer[] = [];
+  for await (const chunk of process.stdin) chunks.push(Buffer.from(chunk as Uint8Array));
+  return Buffer.concat(chunks).toString('utf8');
+}
