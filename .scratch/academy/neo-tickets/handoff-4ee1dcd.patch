+/** `neo role set --mcp` 写前校验:形状(读侧同源)+ 敏感键只许 env:VAR;违规 → state 错。 */
+export function validateMcpForWrite(role: string, text: string): McpServers {
+  const servers = parseRoleMcpText(role, text);
+  for (const [name, server] of Object.entries(servers)) {
+    const check = (map: Readonly<Record<string, string>> | undefined, field: string): void => {
+      for (const [key, value] of Object.entries(map ?? {})) {
+        if (isSecretVarName(key) && !ENV_REF.test(value)) {
+          throw invalid(
+            role,
+            `servers.${name}.${field}.${key} looks like a credential but holds a literal value; reference it as env:VAR (e.g. env:${key.toUpperCase()})`,
+          );
+        }
+      }
+    };
+    if (server.transport === 'stdio') check(server.env, 'env');
+    else check(server.headers, 'headers');
+  }
+  return servers;
+}
+
 /** default ∪ role,同名 role 胜(角色目录后位覆盖)。 */
 export function mergeMcpServers(base: McpServers, override: McpServers): McpServers {
   return { ...base, ...override };
